# Local development on Docker Compose (docker-compose.local.yml).
#
#   cp .env.docker.example .env
#
# Use this instead of .env.example, which targets the Laragon/Windows workflow
# (https://llb-pdf.test + local SQLite) — neither exists in a container.

# COMPOSE_FILE is what lets you type `docker compose up -d` instead of
# `docker compose -f docker-compose.local.yml up -d`.
# UID/GID are baked into the image so bind-mounted files keep host ownership —
# set them from `id -u` / `id -g` (on macOS usually 501 / 20).
COMPOSE_FILE=docker-compose.local.yml
UID=1000
GID=1000
XDEBUG_MODE=off

APP_NAME="llb"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# APP_URL must carry the port: the `public` disk in config/filesystems.php
# builds its URLs from it, and so do redirects and Inertia asset paths.
APP_PORT=8030
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=8031
APP_URL=http://localhost:8030

# The stack serves plain HTTP, so a secure-only cookie would never be sent back
# and every login would silently bounce to /login. .env.example sets this true
# because Laragon fronts the app with https.
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8030,localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The `mysql` container. DB_DATABASE/DB_USERNAME/DB_PASSWORD only apply on the
# FIRST init of the llb-pdf_mysql-data volume — if you already have that
# volume, keep your existing values or authentication breaks.
# Running without Docker? DB_HOST=127.0.0.1 and DB_PORT=8032.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
FORWARD_DB_PORT=8032
DB_DATABASE=llb
DB_USERNAME=llb
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# The `queue` container runs the supervised worker for this stack.
QUEUE_CONNECTION=database
# Must stay above the longest job timeout (ProcessClientCsvImport: 900s),
# otherwise a slow CSV import is handed to a second worker while it still runs.
DB_QUEUE_RETRY_AFTER=1200

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The `mailpit` container catches everything; dashboard on http://localhost:8034
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=8033
FORWARD_MAILPIT_DASHBOARD_PORT=8034

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The Password every seeded staff account starts with. Set it before seeding a
# real install; each person should change it at first login.
SEED_USER_PASSWORD=password
